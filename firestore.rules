rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- User Profiles ---
    match /users/{userId}/profile/{document=**} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // --- Chat History ---
    match /users/{userId}/chats/{document=**} {
      allow read, list, write: if isOwner(userId);
    }

    // --- Budgets (Projects) ---
    match /budgets/{budgetId} {
      
      function isMember() {
        return isSignedIn() && (
          budgetId == request.auth.uid || 
          (resource != null && existing().ownerId == request.auth.uid) ||
          (resource != null && "memberEmails" in existing() && existing().memberEmails.hasAny([request.auth.token.email]))
        );
      }

      function canWrite() {
        return isSignedIn() && (
          budgetId == request.auth.uid || 
          (resource != null && existing().ownerId == request.auth.uid) ||
          (resource != null && "memberRoles" in existing() && existing().memberRoles[request.auth.token.email] in ["editor", "owner"])
        );
      }

      allow get, list: if isMember();
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid;
      allow update: if canWrite() && (
        incoming().ownerId == existing().ownerId &&
        incoming().updatedAt == request.time
      );
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;

      // --- Comments ---
      match /comments/{commentId} {
        allow read, write: if isMember();
      }
    }
  }
}
